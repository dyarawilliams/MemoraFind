<%
  /* ------------------------------------------------------------------------
     One person's record, at an address of its own: /grave/<record ID>.
     Rendered by netlify/functions/renderGrave.js.

     Locals:
       record        one row of the cemetery's base table, composed by
                     displayRecord in baseRecord.js — the same row the
                     search cards read
       cemeteryName  display name of the cemetery the row belongs to
       cemeteryCode  "bcmg" | "capernaum" | "honeyford", the slug the
                     cemetery's search page is built from

     Every line here is a field of that row or a link to a page that already
     exists. Nothing is promised about where the grave is: the source data
     carries no section or lot for almost every record, so the page says so in
     the same words as the search card
     (partials/fact-burial-location.ejs) and no further.

     The heading, the page title and the breadcrumb use the same order:
     given names, maiden name, surname, then suffix — "Caretha Rice Williams",
     or "Robert Smith, Jr." when a suffix was recorded. A comma is written only
     before a suffix. The prefix and the Veteran flag are badges. The Age row
     is shown only when the record has a usable age, and the Veteran badge only
     when the record is flagged as one, both exactly as the card does.

     The correction link at the foot of this page — and only this page — opens
     the GitHub issue form record_correction.yml. The title, cemetery, canonical
     grave URL, record ID and the same heading name are query parameters. Each
     value goes through encodeURIComponent, and the href is printed escaped.
     A missing record, an unreadable record and the administrator pages do not
     include it. */
  var display = {};
  include('partials/record-display.ejs', { display: display });

  var record = (typeof locals.record === "object" && locals.record) ? locals.record : {};
  var cemeteryName = (typeof locals.cemeteryName === "string") ? locals.cemeteryName : "";
  var cemeteryCode = (typeof locals.cemeteryCode === "string") ? locals.cemeteryCode : "";
  var memorialId = (record.memorial_id === null || record.memorial_id === undefined) ? "" : String(record.memorial_id);

  function recordedText(value) {
      return (value === null || value === undefined) ? "" : String(value).trim();
  }

  var surname = recordedText(record.last_name);
  var givenNames = [record.first_name, record.middle_name]
      .filter(function (part) { return recordedText(part) !== ""; })
      .join(" ");
  var suffix = recordedText(record.suffix);
  var prefix = recordedText(record.prefix);
  var maidenName = recordedText(record.maiden_name);

  /* Same order as the heading below. The comma belongs to the suffix
     ("Smith, Jr."), so a record with no suffix does not end in one. */
  var nameBeforeSuffix = [givenNames, maidenName, surname]
      .filter(function (part) { return part !== ""; })
      .join(" ");
  var nameText = suffix
      ? (nameBeforeSuffix ? nameBeforeSuffix + ", " + suffix : suffix)
      : nameBeforeSuffix;

  var bornDate = display.formatRecordedDate(record.birth_date);
  var diedDate = display.formatRecordedDate(record.death_date);
  var ageYears = display.formatRecordedAge(record.age_sane);
  var bornYear = display.recordedYear(record.birth_date);
  var diedYear = display.recordedYear(record.death_date);
  var isVet = record.is_vet == "Y";
  var extraParts = ["notes", "moved_from", "moved_to"].filter(function (field) {
      return recordedText(record[field]) !== "";
  });

  /* A title and a description that make sense when the address is pasted into
     a message: the name, the years the record actually carries, and the
     cemetery. A year displayRecord wrote as a zero placeholder is left out rather
     than printed (see partials/record-display.ejs). No location is claimed. */
  var yearsText = "";
  if (bornYear && diedYear) yearsText = bornYear + "–" + diedYear;
  else if (bornYear) yearsText = "b. " + bornYear;
  else if (diedYear) yearsText = "d. " + diedYear;

  var pageTitle = nameText
      + (yearsText ? " (" + yearsText + ")" : "")
      + (cemeteryName ? " — " + cemeteryName : "")
      + " — MemoraFind";

  var lifeText = [];
  if (bornDate) lifeText.push("born " + bornDate);
  if (diedDate) lifeText.push("died " + diedDate);
  var pageDescription = [nameText, lifeText.join(", "), cemeteryName]
      .filter(function (part) { return part !== ""; }).join(" — ")
      + ". Record ID " + memorialId + ". Burial records for Bamberg County, South Carolina.";

  /* Person structured data. A date or a cemetery the record does not carry is
     left out — never a zero, never a guessed section or lot. The name is the
     same string as the title: given names, maiden name, surname, and a comma
     only before a suffix. "<" is escaped so a name cannot close the script. */
  var person = { "@context": "https://schema.org", "@type": "Person" };
  if (nameText) person.name = nameText;
  if (/^\d+$/.test(memorialId)) person.url = "https://memorafind.com/grave/" + memorialId;
  var birthIso = display.isoDate(record.birth_date);
  var deathIso = display.isoDate(record.death_date);
  if (birthIso) person.birthDate = birthIso;
  if (deathIso) person.deathDate = deathIso;
  if (cemeteryName) {
      person.burialPlace = {
          "@type": "Cemetery",
          "name": cemeteryName,
          "containedInPlace": {
              "@type": "AdministrativeArea",
              "name": "Bamberg County, South Carolina"
          }
      };
  }
  var jsonLd = JSON.stringify(person)
      .replace(/</g, "\\u003c")
      .replace(/>/g, "\\u003e")
      .replace(/&/g, "\\u0026")
      .replace(/\u2028/g, "\\u2028")
      .replace(/\u2029/g, "\\u2029");

  /* These are the option labels on the cemetery dropdown in
     .github/ISSUE_TEMPLATE/record_correction.yml. A value that is not one of
     them is left off the link: GitHub only prefills a dropdown when the query
     value matches an option exactly. */
  var correctionCemeteries = [
      "Bamberg County Memory Gardens",
      "Capernaum Cemetery",
      "Honey Ford Cemetery"
  ];
  var correctionTitle = "Correction: " + (nameText || "record");
  if (memorialId) correctionTitle += " (" + memorialId + ")";
  var correctionFields = [
      ["template", "record_correction.yml"],
      ["title", correctionTitle]
  ];
  if (correctionCemeteries.indexOf(cemeteryName) !== -1) {
      correctionFields.push(["cemetery", cemeteryName]);
  }
  if (/^\d+$/.test(memorialId)) {
      correctionFields.push(["record", "https://memorafind.com/grave/" + memorialId]);
      correctionFields.push(["record_id", memorialId]);
  }
  if (nameText) correctionFields.push(["name", nameText]);
  var correctionUrl = "https://github.com/dyarawilliams/MemoraFind/issues/new?" + correctionFields.map(function (field) {
      return encodeURIComponent(field[0]) + "=" + encodeURIComponent(field[1]);
  }).join("&");
%>
<%- include('partials/header.ejs', {
      pageTitle: pageTitle,
      pageDescription: pageDescription,
      canonicalPath: (memorialId ? "/grave/" + memorialId : "/"),
      jsonLd: jsonLd
    }) %>

        <div class="page page--narrow">
            <div class="container">
                <nav class="breadcrumb" aria-label="Breadcrumb">
                    <ol>
                        <li><a href="/">Home</a></li>
                        <% if (cemeteryName && cemeteryCode) { %>
                            <li><a href="/search/<%= cemeteryCode %>"><%= cemeteryName %></a></li>
                        <% } %>
                        <li aria-current="page"><%= nameText %></li>
                    </ol>
                </nav>

                <article class="record">
                    <div class="record__head">
                        <h1 class="record__name record__name--page"><%
                            if (givenNames) { %><span class="record__given"><%= givenNames %></span><% }
                            if (maidenName) {
                                if (givenNames) { %> <% }
                                %><span class="record__maiden"><%= maidenName %></span><%
                            }
                            if (surname) {
                                if (givenNames || maidenName) { %> <% }
                                %><span class="record__surname"><%= surname %></span><%
                            }
                            if (suffix) {
                                if (givenNames || maidenName || surname) { %>, <% }
                                %><span class="record__given"><%= suffix %></span><%
                            }
                        %></h1>
                        <ul class="record__badges">
                            <li>
                                <span class="badge badge--id">
                                    <span class="badge__key">Record ID</span>
                                    <strong><%= memorialId %></strong>
                                </span>
                            </li>
                            <% if (prefix) { %>
                                <li><span class="badge badge--neutral"><%= prefix %></span></li>
                            <% } %>
                            <% if (isVet) { %>
                                <li><span class="badge badge--vet">Veteran</span></li>
                            <% } %>
                        </ul>
                    </div>

                    <dl class="record__facts">
                        <div class="fact<%= bornDate ? '' : ' fact--muted' %>">
                            <dt>Born</dt>
                            <dd><%= bornDate || display.MISSING_TEXT %></dd>
                        </div>
                        <div class="fact<%= diedDate ? '' : ' fact--muted' %>">
                            <dt>Died</dt>
                            <dd><%= diedDate || display.MISSING_TEXT %></dd>
                        </div>
                        <% if (ageYears) { %>
                            <div class="fact">
                                <dt>Age</dt>
                                <dd><%= ageYears %></dd>
                            </div>
                        <% } %>
                        <% if (cemeteryName) { %>
                            <div class="fact fact--wide">
                                <dt>Cemetery</dt>
                                <dd><%= cemeteryName %></dd>
                            </div>
                        <% } %>
                        <%- include('partials/fact-burial-location.ejs', { record: record }) %>
                    </dl>

                    <% if (extraParts.length > 0) { %>
                        <details class="record__extra">
                            <summary>More details</summary>
                            <dl class="record__facts">
                                <% if (recordedText(record.notes) !== "") { %>
                                    <div class="fact fact--wide">
                                        <dt>Notes</dt>
                                        <dd><p><%= record.notes %></p></dd>
                                    </div>
                                <% } %>
                                <% if (recordedText(record.moved_from) !== "") { %>
                                    <div class="fact fact--wide">
                                        <dt>Moved from</dt>
                                        <dd><%= record.moved_from %></dd>
                                    </div>
                                <% } %>
                                <% if (recordedText(record.moved_to) !== "") { %>
                                    <div class="fact fact--wide">
                                        <dt>Moved to</dt>
                                        <dd><%= record.moved_to %></dd>
                                    </div>
                                <% } %>
                            </dl>
                        </details>
                    <% } %>
                </article>

                <nav class="page__toolbar" aria-label="Other records">
                    <% if (cemeteryName && cemeteryCode) { %>
                        <a class="btn btn--primary" href="/search/<%= cemeteryCode %>">Search <%= cemeteryName %></a>
                    <% } %>
                    <a class="btn btn--ghost" href="/#search">Search all three cemeteries</a>
                </nav>

                <div class="notice grave-note" role="note">
                    <svg class="notice__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                        <path d="M10 1.8a8.2 8.2 0 1 0 0 16.4 8.2 8.2 0 0 0 0-16.4Zm0 3a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2Zm1.1 10.1H8.9v-1.1h.7V10h-.7V8.9h2.2v4.9h.7Z" fill="currentColor" />
                    </svg>
                    <div class="grave-note__body">
                        <p>
                            <a class="grave-note__report" href="<%= correctionUrl %>" target="_blank" rel="noopener noreferrer" aria-describedby="grave-correction-note">Report a correction<span class="visually-hidden"> (opens in a new tab)</span></a>
                        </p>
                        <p id="grave-correction-note">
                            Reporting a correction opens a GitHub issue and needs a free GitHub account.
                            You can also send a correction from the <a class="grave-note__contact" href="/contact">Contact page</a>.
                            This page only shows the record MemoraFind holds.
                        </p>
                    </div>
                </div>
            </div>
        </div>

<%- include('partials/footer.ejs') %>
