<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bamberg County Cemetery Search</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="wrapper">
        <header>
            <h1>Bamberg County (SC) Cemetery Search</h1>
            <a href="/.netlify/functions/updatePage">Update a Record (requires login)</a>
            <a href="/">Back to Home</a>
        </header>

        <div class="search-container">
            <form action="/search/<%= cemetery %>" method="GET" id="search-form-2" class="search-form">
                <h2>Search Records</h2>
                <p>Enter as many values as known. Leave fields blank for all records.</p>
                <div class="name-fields">
                    <div class="form-group">
                        <label for="lastName">Last Name:</label>
                        <input type="text" id="lastName" name="lastName" placeholder="Deer" />
                    </div>
                    <div class="form-group">
                        <label for="firstName">First Name:</label>
                        <input type="text" id="firstName" name="firstName" placeholder="John" />
                    </div>
                    <div class="form-group">
                        <label for="maidenName">Maiden Name:</label>
                        <input type="text" id="maidenName" name="maidenName" placeholder="Doe" />
                    </div>
                </div>
                <div class="date-fields">
                    <div class="form-group">
                        <label for="birthYear">Birth Year:</label>
                        <input type="number" id="birthYear" name="birthYear" min="1700" max="2050" placeholder="1952"/>
                    </div>
                    <div>
                        <label for="deathYear">Death Year:</label>
                        <input type="number" id="deathYear" name="deathYear" min="1700" max="2050" placeholder="2021" />
                    </div>
                </div>
                <button type="submit">Search</button>
            </form>
        </div>
        <div class="results-section">
            <h2>Search Results</h2>
            <span>To correct or update a record, contact the admin to log in. Note the ID value of the record you wish to update, as this will be required.</span>
            <% if (!hasSearchParams) { %>
                <p>Enter search criteria above to find records.</p>
            <% } else if (records && records.length > 0) { %>
                <p>Found <%= records.length %> record(s) matching your search criteria.</p>
                <div class="table-responsive">
                    
                    <% records.forEach(function(record) { %>
                        <div class="card mb-3">
                            <header class="card-header">
                                <strong class="card-subtitle">ID: <%= record.memorial_id %></strong> 
                            </header>
                            <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <p class="card-title">Prefix: <%= (record.prefix) ? record.prefix : "N/A" %></p>
                                        <h5 class="card-text"><%= record.last_name %> <%= record.maiden_name %>, <%= record.first_name %> <%= record.middle_name %> <%= record.suffix %></h5>
                                        <p class="card-text">Age: <%= record.age_sane %></p>
                                    </div>
                                    <div class="d-flex justify-content-evenly">
                                        <p class="card-text">Birth Date: <%= record.birth_date %></p>
                                        <p class="card-text">Death Date: <%= record.death_date %></p>
                                    </div>
                                    <div class="d-flex justify-content-evenly">
                                        <p class="card-text">Section: <%= (record.section) ? record.section : "N/A" %></p>
                                        <p class="card-text">Lot: <%= (record.lot) ? record.lot : "N/A" %></p>
                                    </div>
                                    <p class="card-text text-center">Veteran: <%= (record.isVet === "Y") ? "Yes" : "No" %></p>

                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                No records found matching your search criteria.
            <% } %>
        </div>
        
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js" integrity="sha384-k6d4wzSIapyDyv1kpU366/PK5hCdSbCRGRCMv+eplOQJWyd1fbcAu9OCUj5zNLiq" crossorigin="anonymous"></script>
</body>
</html>