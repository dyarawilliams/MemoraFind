<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bamberg County Cemetery Plot Search</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <div class="wrapper">
        <header>
            <h1>Bamberg County (SC) Cemetery Plot Search</h1>
            <a href="/.netlify/functions/updatePage">Update a Record (requires login)</a>
        </header>

        <div class="search-container">
            <form action="/.netlify/functions/renderSearch" method="GET" id="search-form-1" class="search-form">
                <h2>Quick Search</h2>
                <select name="cemetery" id="cemetery-select" required>
                    <option value="">Select Cemetery</option>
                    <option value="bcmg">Bamberg County Memory Gardens</option>
                    <option value="capernaum">Capernaum Cemetery</option>
                    <option value="honeyford">Honey Ford Cemetery</option>
                </select>
                <button type="submit">Search</button>
            </form>
        </div>
        
        <div class="cemetery-grid">
            <div class="cemetery-card" data-cemetery="bcmg">
                <h2>Bamberg County Memory Gardens</h2>
                <img src="assets/bcmg.jpg" alt="Bamberg County Memory Gardens">
                <p>Located on Highway 301</p>
                <a href="/search/bcmg" class="cemetery-link">Search Records</a>
            </div>
            
            <div class="cemetery-card" data-cemetery="capernaum">
                <h2>Capernaum Cemetery</h2>
                <img src="assets/placeholder.png" alt="Capernaum Cemetery">
                <p>Lorem ipsum dolor sit amet consectetur adipisicing elit.</p>
                <a href="/search/capernaum" class="cemetery-link">Search Records</a>
            </div>

            <div class="cemetery-card" data-cemetery="honeyford">
                <h2>Honey Ford Cemetery</h2>
                <img src="assets/placeholder.png" alt="Honey Ford Cemetery">
                <p>Lorem ipsum dolor, sit amet consectetur adipisicing elit.</p>
                <a href="/search/honeyford" class="cemetery-link">Search Records</a>
            </div>
        </div>
    </div>
    <footer>
        <p>
            &copy; 2025 MemoraFind. All rights reserved.
        </p>
    </footer>

    <script>
        document.getElementById('cemetery-select').addEventListener('change', function() {
            const selectedCemetery = this.value;
            const cards = document.querySelectorAll('.cemetery-card');
            
            cards.forEach(card => {
                if (!selectedCemetery || card.dataset.cemetery === selectedCemetery) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        });

        document.getElementById('search-form-1').addEventListener('submit', function(e) {
            e.preventDefault();
            const cemetery = document.getElementById('cemetery-select').value;
            
            if (cemetery) {
                window.location.href = `/search/${cemetery}`;
            }
        });
    </script>
</body>

</html>