    <script>
        /* Mobile navigation toggle. No framework, no dependency: the button
           flips aria-expanded and a class on the header, and CSS does the rest
           (the nav is only collapsible below the 860px breakpoint). */
        (function () {
            var header = document.querySelector('[data-site-header]');
            var toggle = document.querySelector('[data-nav-toggle]');
            if (!header || !toggle) return;

            function setOpen(open) {
                header.classList.toggle('is-nav-open', open);
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            }

            toggle.addEventListener('click', function () {
                setOpen(toggle.getAttribute('aria-expanded') !== 'true');
            });

            /* Escape closes the menu and returns focus to the button. */
            header.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
                    setOpen(false);
                    toggle.focus();
                }
            });

            /* A click outside the header closes it. */
            document.addEventListener('click', function (event) {
                if (!header.contains(event.target)) setOpen(false);
            });

            /* Leaving the mobile breakpoint resets the state. */
            window.addEventListener('resize', function () {
                if (window.innerWidth >= 860) setOpen(false);
            });
        })();
    </script>
    <script>
        /* Browser errors go to the log function. Five reports per page, and the
           function itself caps size and rate. The path is the pathname only.
           A failure to report is ignored so this script cannot raise another. */
        (function () {
            var endpoint = '/.netlify/functions/logClientError';
            var sent = 0;

            function report(payload) {
                if (sent >= 5) return;
                sent += 1;
                var body;
                try {
                    body = JSON.stringify(payload);
                } catch (ignore) {
                    return;
                }
                if (body.length > 3500) body = body.slice(0, 3500);
                try {
                    if (navigator.sendBeacon) {
                        var queued = navigator.sendBeacon(endpoint, new Blob([body], { type: 'application/json' }));
                        if (queued) return;
                    }
                } catch (ignoreBeacon) {}
                try {
                    fetch(endpoint, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: body,
                        keepalive: true
                    }).catch(function () {});
                } catch (ignoreFetch) {}
            }

            window.onerror = function (message, source, lineno, colno, error) {
                report({
                    kind: 'error',
                    message: message == null ? '' : String(message).slice(0, 500),
                    source: source == null ? '' : String(source).slice(0, 200),
                    lineno: lineno || 0,
                    colno: colno || 0,
                    stack: error && error.stack ? String(error.stack).slice(0, 1500) : '',
                    path: location.pathname || '/'
                });
            };

            window.addEventListener('unhandledrejection', function (event) {
                var reason = event && event.reason;
                var message = (reason && reason.message) ? reason.message : String(reason == null ? '' : reason);
                report({
                    kind: 'unhandledrejection',
                    message: String(message).slice(0, 500),
                    stack: reason && reason.stack ? String(reason.stack).slice(0, 1500) : '',
                    path: location.pathname || '/'
                });
            });
        })();
    </script>
