<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="hsl(358, 72%, 21%)" />
    <%
      /* pageTitle is supplied by each template through include(... , { pageTitle }) */
      var _pageTitle = (typeof pageTitle !== "undefined" && pageTitle)
          ? pageTitle
          : "MemoraFind — Bamberg County cemetery records";
      /* pageDescription is optional. Only the single-record page passes one, so
         that a pasted link describes that person; every other page keeps the
         site's own description. */
      var _pageDescription = (typeof pageDescription !== "undefined" && pageDescription)
          ? pageDescription
          : "MemoraFind is a free grave-finder for Bamberg County, South Carolina: search burial records from Bamberg County Memory Gardens, Capernaum Cemetery and Honey Ford Cemetery by name, maiden name, birth or death year.";

      /* ---- noindex -------------------------------------------------------
         A page that is not a destination of its own can ask not to be indexed.
         Two pass it: the administrator update page (/search/update, an admin
         lookup that has no business competing with the home page in a search
         result) and the static 404 page (public/404.html, which has no address
         of its own and is never the page someone meant to find). Every other
         page leaves it out, so no crawlable page changes. */
      var _noindex = (typeof noindex !== "undefined" && noindex === true);
      /* ---- Link previews (Open Graph / Twitter) --------------------------
         Shareable pages need absolute addresses, so every URL below is built
         on the production apex and never on a netlify host or a deploy-preview
         host — a preview's own address would otherwise be baked into the card
         that a shared link shows. SITE_ORIGIN is the one place to change it.

         canonicalPath is optional and defaults to the home page. Only the
         templates whose real path is already known pass it, without a new
         query: grave.ejs passes "/grave/<record ID>", search.ejs passes
         "/search/<cemetery slug>" and update.ejs passes "/search/update",
         which is the address that page is served at. The landing page keeps
         "/". A template can also pass `false`, which prints no canonical and
         no og:url at all: that is for the 404 page, which has no address of
         its own and must not point search engines at the home page instead.

         The share image is a static file under public/assets/, so it is served
         straight from the CDN at /assets/og-card.png and no function is
         involved. The alt text repeats exactly what the card itself claims:
         that records can be searched and every person has a page of their own.
         It says nothing about a section, lot or grave location, because the
         source data carries none for 2,425 of 2,428 records. */
      var SITE_ORIGIN = "https://memorafind.com";
      var _canonicalPath = ((typeof canonicalPath !== "undefined") && canonicalPath === false)
          ? null
          : ((typeof canonicalPath === "string" && canonicalPath.charAt(0) === "/")
              ? canonicalPath
              : "/");
      var _canonicalUrl = _canonicalPath ? SITE_ORIGIN + _canonicalPath : null;
      var _shareImage = SITE_ORIGIN + "/assets/og-card.png";
      var _shareImageAlt = "MemoraFind, Bamberg County, SC — search Bamberg County burial records; every person has a page of their own.";
      /* currentNav is optional. The contact page passes "contact" so the
         matching link in this nav can be marked as the current page. */
      var _currentNav = (typeof currentNav !== "undefined" && currentNav) ? currentNav : "";
    %>
    <title><%= _pageTitle %></title>
    <meta name="description" content="<%= _pageDescription %>" />
    <% if (_noindex) { %><meta name="robots" content="noindex, nofollow" /><% } %>
    <% if (_canonicalUrl) { %><link rel="canonical" href="<%= _canonicalUrl %>" /><% } %>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MemoraFind" />
    <meta property="og:title" content="<%= _pageTitle %>" />
    <meta property="og:description" content="<%= _pageDescription %>" />
    <% if (_canonicalUrl) { %><meta property="og:url" content="<%= _canonicalUrl %>" /><% } %>
    <meta property="og:image" content="<%= _shareImage %>" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="<%= _shareImageAlt %>" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= _pageTitle %>" />
    <meta name="twitter:description" content="<%= _pageDescription %>" />
    <meta name="twitter:image" content="<%= _shareImage %>" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%235c0f12'/%3E%3Cpath d='M7 26V15a9 9 0 0 1 18 0v11' fill='none' stroke='%23e0a906' stroke-width='2.4' stroke-linecap='round'/%3E%3Cpath d='M12 19h8M12 23h5' fill='none' stroke='%23e0a906' stroke-width='2.4' stroke-linecap='round'/%3E%3C/svg%3E" />
    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header" data-site-header>
        <div class="container site-header__inner">
            <a class="brand" href="/">
                <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                    <path d="M5 29V15a11 11 0 0 1 22 0v14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M11 19.5h10M11 24h6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                </svg>
                <span class="brand__text">
                    <span class="brand__name">MemoraFind</span>
                    <span class="brand__tag">Bamberg County, SC</span>
                </span>
            </a>

            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
                <span class="nav-toggle__bars" aria-hidden="true"></span>
                <span class="nav-toggle__label">Menu</span>
            </button>

            <nav class="site-nav" id="site-nav" aria-label="Main navigation">
                <ul class="site-nav__list">
                    <li><a href="/">Home</a></li>
                    <li><a href="/#search">Search records</a></li>
                    <li><a href="/#cemeteries">Cemeteries</a></li>
                    <li><a href="/contact"<% if (_currentNav === "contact") { %> aria-current="page"<% } %>>Contact Us</a></li>
                    <li>
                        <a class="site-nav__admin" href="/.netlify/functions/updatePage">
                            Update a record
                            <span class="site-nav__hint">admin login</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </header>

    <main id="main" class="site-main">
