<%- include('partials/header.ejs') %>
<body>
    <header class="d-flex justify-content-between">
        <h1>MemoraFind</h1>
        <div class="d-flex align-items-center">
            <a href="/" class="btn btn-secondary mx-2">Home</a>
            <a href="/.netlify/functions/updatePage" class="btn btn-success">Update a Record (requires login)</a>
        </div>
    </header>
    <div class="mt-3 d-flex flex-column align-items-center">
        <h1>Admin Login</h1>
        <p>Enter the administrator password to make changes to cemetery records.</p>
        <h2>This session will expire in 10 minutes.</h2>
        <form action="/.netlify/functions/login" method="POST" id="login-form">
            <div class="form-group mb-3">
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="Enter password" required />
            </div>
            <button type="submit" class="w-100 btn btn-success btn-md">Login</button>
            <h3><%= message %></h3>
        </form>
    </div>
<%- include('partials/footer.ejs') %>