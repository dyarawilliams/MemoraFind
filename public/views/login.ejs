<%- include('partials/header.ejs', { pageTitle: 'Administrator login — MemoraFind' }) %>

        <div class="page page--narrow">
            <nav class="breadcrumb" aria-label="Breadcrumb">
                <ol>
                    <li><a href="/">Home</a></li>
                    <li aria-current="page">Administrator login</li>
                </ol>
            </nav>

            <div class="panel">
                <h1>Admin login</h1>
                <p class="panel__intro">
                    Enter the administrator password to make changes to cemetery records.
                </p>
                <h2 class="subhead">This session will expire in 10 minutes.</h2>

                <form action="/.netlify/functions/login" method="POST" id="login-form" class="page-form">
                    <div class="field">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="Enter password" autocomplete="current-password" required />
                    </div>

                    <button type="submit" class="btn btn--primary btn--block">Login</button>

                    <% if (typeof locals.message !== "undefined" && locals.message) { %>
                        <p class="notice notice--error" role="alert">
                            <svg class="notice__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                                <path d="M10 1.8a8.2 8.2 0 1 0 0 16.4 8.2 8.2 0 0 0 0-16.4Zm0 3a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2Zm1.1 10.1H8.9v-1.1h.7V10h-.7V8.9h2.2v4.9h.7Z" fill="currentColor" />
                            </svg>
                            <span><%= locals.message %></span>
                        </p>
                    <% } %>
                </form>
            </div>
        </div>

<%- include('partials/footer.ejs') %>
