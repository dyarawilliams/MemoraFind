# Copy to .env and replace the placeholders. Do not commit .env.
# `npm start` runs `netlify dev`, which loads .env into the function process.
# Names below are every process.env variable the functions read.
# Leave an optional value empty to keep that feature off.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-supabase-anon-key
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=your-site-password
# Optional. Form is scrypt:<salt hex>:<key hex>. Empty uses ADMIN_PASSWORD for site login.
ADMIN_PASSWORD_HASH=
# Optional. Supabase Auth password when it differs from ADMIN_PASSWORD.
SUPABASE_ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=replace-with-at-least-16-random-characters
# Optional. An https Sentry DSN. Empty keeps error reports in the Netlify log only.
SENTRY_DSN=
